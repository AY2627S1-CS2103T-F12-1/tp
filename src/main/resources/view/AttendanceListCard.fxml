<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" alignment="CENTER_LEFT" spacing="10"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="5" right="15" bottom="5" left="15" />
  </padding>
  <!-- Keep long names from widening the list; the details column still grows to fill available space. -->
  <VBox HBox.hgrow="ALWAYS" prefWidth="150" minHeight="60" minWidth="0" alignment="CENTER_LEFT">
    <HBox spacing="0.5" alignment="TOP_LEFT">
      <Label fx:id="id" styleClass="cell_big_label">
        <minWidth>
          <!-- Ensures that the label text is never truncated -->
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <Label fx:id="name" styleClass="cell_big_label" wrapText="true" minWidth="0" maxWidth="Infinity"
             HBox.hgrow="ALWAYS" />
    </HBox>
    <Label fx:id="studentId" styleClass="cell_small_label" />
  </VBox>
  <Label fx:id="status" styleClass="attendance_status">
    <minWidth>
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>
</HBox>
