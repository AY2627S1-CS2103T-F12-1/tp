@startuml
actor User
participant ":LogicManager" as LogicManager
participant ":AddressBookParser" as AddressBookParser
participant ":FindCommandParser" as FindCommandParser
participant "f:FindCommand" as FindCommand
participant ":Model" as Model
participant "predicate:NameContainsKeywordsPredicate" as Predicate

User -> LogicManager : execute("find n/Alex")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("find n/Alex")
activate AddressBookParser

AddressBookParser -> FindCommandParser : parse(" n/Alex")
activate FindCommandParser
note right of FindCommandParser
Validate exactly one non-empty
n/, i/, e/, r/, or l/ parameter.
Reject unknown or repeated prefixes.
end note
FindCommandParser --> AddressBookParser : f
deactivate FindCommandParser

AddressBookParser --> LogicManager : f
deactivate AddressBookParser

note over LogicManager
Reject find if startup loading failed.
Otherwise execute on the live model without saving.
end note
LogicManager -> FindCommand : execute(model)
activate FindCommand

FindCommand -> Model : updateFilteredPersonList(predicate)
activate Model
loop each student in the complete list
Model -> Predicate : test(person)
Predicate --> Model : true/false
end
note right of Predicate
Match any keyword as a case-insensitive substring of the name.
end note
Model --> FindCommand
deactivate Model

FindCommand -> Model : getFilteredPersonList().size()
Model --> FindCommand : matching count
FindCommand --> LogicManager : CommandResult(Messages.formatStudentsListed(count))
deactivate FindCommand

LogicManager -> LogicManager : displayedAttendance = null
LogicManager --> User : result message
deactivate LogicManager
@enduml
