@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":AddressBookParser" as Parser LOGIC_COLOR
participant ":UndoCommandParser" as UndoParser LOGIC_COLOR
end box
actor User
box Model MODEL_COLOR_T1
participant "live:Model" as Live MODEL_COLOR
end box
participant ":Storage" as Storage STORAGE_COLOR

User -> Logic : execute("undo")
activate Logic
Logic -> Parser : parseCommand(commandText)
activate Parser
Parser -> UndoParser : parse(arguments)
activate UndoParser
UndoParser --> Parser : UndoCommand
deactivate UndoParser
Parser --> Logic : UndoCommand
deactivate Parser

note over Logic
Reject undo if startup loading failed.
LogicManager handles undo directly;
UndoCommand.execute(model) is not called.
Save errors map to messages for external changes,
another writer, storage location, or general I/O failure.
end note

alt no retained snapshot
    Logic --> User : CommandResult("Nothing to undo.")
else retained snapshot exists
    Logic -> Storage : saveAddressBook(latestSnapshot)
    activate Storage
    alt save succeeds
        Storage --> Logic : saved
        Logic -> Live : setAddressBook(latestSnapshot)
        Logic -> Live : updateFilteredPersonList(showAll)
        Logic -> Logic : remove latest snapshot
        Logic --> User : CommandResult("Undid last change.")
    else save fails
        Storage --> Logic : IOException (save error)
        note over Live
        Live records and the displayed list are unchanged.
        The retained snapshot is not removed.
        end note
        Logic --> User : CommandException
    end
    deactivate Storage
end
note over Logic
On a successful result, close any displayed attendance report.
On failure, keep the report and history unchanged.
end note
deactivate Logic
@enduml
